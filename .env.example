# Copy this file to .env and customize as needed.
# DO NOT commit .env to version control.
#
# Generate local files first:
#   ./tools/generate_secrets.sh
#   uv run python tools/generate_certs.py

# AO service-token issuer. Must match the `iss` claim on tokens EP verifies.
EP_AO_JWT_ISSUER=http://localhost:8000
EP_AO_CLIENT_ID=syntara-orchestration

# Host paths mounted into the API/worker containers.
EP_CREDENTIAL_ENCRYPTION_KEY_FILE=.secrets/encryption-key
EP_AO_JWT_PUBLIC_KEY_FILE=.secrets/ao-jwt-public.pem
EP_API_TLS_CERT_FILE=.secrets/certs/execution-plane.crt
EP_API_TLS_KEY_FILE=.secrets/certs/execution-plane.key
EP_API_TLS_CLIENT_CA_FILE=.secrets/certs/ca.pem

# Published API port on the host loopback interface.
EP_API_PUBLISH_PORT=8001

# Optional worker callback into Syntara. Leave empty for API-only local bring-up.
# EP_COMPLETION_CALLBACK_URL=https://localhost:8000/api/execution_plane/v1/commands

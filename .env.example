# Side-by-side development: ../syntara and ../syntara-execution-plane.
# Generate secrets, then review .secrets/command-peers.json before startup.
# Use AO's development CA when issuing EP certificates (see README.md).
EP_CREDENTIAL_ENCRYPTION_KEY_FILE=.secrets/encryption-key
EP_COMMAND_PEERS_FILE=.secrets/command-peers.json
EP_COMMAND_SIGNING_KEY_FILE=.secrets/ep-command.pem
EP_COMMAND_PUBLIC_KEY_FILE=.secrets/ep-command.pub
EP_COMMAND_SIGNING_KEY_ID=primary
EP_AO_JWT_PUBLIC_KEY_FILE=.secrets/ao-jwt-public.pem
EP_API_TLS_CERT_FILE=.secrets/certs/execution-plane.crt
EP_API_TLS_KEY_FILE=.secrets/certs/execution-plane.key
EP_API_TLS_CLIENT_CA_FILE=.secrets/certs/ca.pem
EP_IMAGE=localhost/execution-plane:latest
EP_JOURNAL_IMAGE=localhost/execution-plane-journal:latest
EP_API_PUBLISH_PORT=8001
EP_JOURNAL_API_PUBLISH_PORT=8002
